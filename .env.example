# Copy to .env and edit. Only needed from Stage 3 (agent) onward.
# The default setup is free: the agent runs on a local model through Ollama.

# Which LLM backend the agent uses: "ollama" (free, local) or "anthropic" (paid API)
LLM_PROVIDER=ollama

# Ollama settings. Download the model once with: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Optional: only used when LLM_PROVIDER=anthropic.
# Install the extra with: uv sync --extra claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
